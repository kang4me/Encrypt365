<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.kang.view.urlui.urlUI">
  <grid id="27dc6" binding="UI" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="801" height="729"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="670a3" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="5" bottom="0" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <minimumSize width="400" height="40"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="13f47" class="javax.swing.JComboBox" binding="model">
            <constraints/>
            <properties>
              <minimumSize width="100" height="150"/>
              <preferredSize width="150" height="30"/>
            </properties>
          </component>
          <component id="ba755" class="javax.swing.JComboBox" binding="charSet">
            <constraints/>
            <properties>
              <minimumSize width="100" height="150"/>
              <preferredSize width="150" height="30"/>
            </properties>
          </component>
          <component id="727e4" class="javax.swing.JButton" binding="encode">
            <constraints/>
            <properties>
              <preferredSize width="100" height="35"/>
              <text value="编码"/>
            </properties>
          </component>
          <component id="d8f5a" class="javax.swing.JButton" binding="decode">
            <constraints/>
            <properties>
              <preferredSize width="100" height="35"/>
              <text value="解码"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="7a358" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="5520b">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="150"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="16e1b" class="javax.swing.JTextArea" binding="urlEncode">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <text value=""/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="13456" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="9a43e">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="150"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="73ae4" class="javax.swing.JTextArea" binding="urlDecode">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
